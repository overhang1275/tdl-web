[Unit]
Description=Telegram Downloader RQ worker
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=telegramdl
Group=telegramdl
WorkingDirectory=/opt/telegram-downloader/app
EnvironmentFile=/etc/telegram-downloader/telegram-downloader.env
ExecStart=/opt/telegram-downloader/venv/bin/python -m app.rq_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

