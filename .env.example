APP_ENV=production
SECRET_KEY=change-this-long-random-value
DATA_DIR=/opt/telegram-downloader/data
TDL_SESSIONS_DIR=/opt/telegram-downloader/data/sessions
EXPORTS_DIR=/opt/telegram-downloader/data/exports
DOWNLOADS_DIR=/opt/telegram-downloader/data/downloads
LOGS_DIR=/opt/telegram-downloader/data/logs
DATABASE_URL=sqlite:////opt/telegram-downloader/data/telegram_downloader.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
TDL_BINARY=/usr/local/bin/tdl
TDL_NAMESPACE=default
COMMAND_TIMEOUT_SECONDS=7200

