APP_ENV=production
SECRET_KEY=change-this-long-random-value
WEB_PASSWORD=change-this-local-password
DATA_DIR=/opt/tld-web/data
TDL_SESSIONS_DIR=/opt/tld-web/data/sessions
EXPORTS_DIR=/opt/tld-web/data/exports
DOWNLOADS_DIR=/opt/tld-web/data/downloads
LOGS_DIR=/opt/tld-web/data/logs
DATABASE_URL=sqlite:////opt/tld-web/data/telegram_downloader.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
TDL_BINARY=/usr/local/bin/tdl
TDL_NAMESPACE=default
COMMAND_TIMEOUT_SECONDS=7200
